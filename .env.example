# Discord application (developer.discord.com/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Must match a redirect registered on the Discord application exactly
DISCORD_REDIRECT_URI=http://localhost:3001/auth/discord/callback

# Postgres (Render/Railway managed instance, or local for dev)
DATABASE_URL=postgres://user:password@localhost:5432/rostr

# Any random string — signs session tokens
SESSION_SECRET=

# Stripe (dashboard.stripe.com, use test keys until launch)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_ENTERPRISE=

# Where the Next.js frontend runs, for OAuth redirects and CORS
WEB_BASE_URL=http://localhost:3000
PORT=3001
